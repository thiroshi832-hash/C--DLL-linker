<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 is the newest .NET Framework and the newest CLR that installs on
         Windows 7 SP1. .NET (Core) 6/7/8 require Windows 10+, so they are ruled
         out for a Win 7 target; net48 is the ceiling. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ManagedBridge</AssemblyName>
    <RootNamespace>ManagedBridge</RootNamespace>
    <Nullable>disable</Nullable>

    <!-- The runtime is booted by the native host via mscoree.dll COM hosting,
         so there is no runtimeconfig.json and no EnableDynamicLoading here. -->
  </PropertyGroup>

  <!-- The dispatcher loads the fixed DLL purely by reflection at runtime, so we
       do NOT reference it at compile time. Just make sure ThirdParty.dll ends up
       in the same output folder (the demo copies it; see README). -->

</Project>
